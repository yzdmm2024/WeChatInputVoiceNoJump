			<string>启用外观定制</string>
			<key>Key</key>
			<string>wxkbdStyleEnabled</string>
			<key>DefaultValue</key>
			<false/>
		</dict>
		<dict>
			<key>Type</key>
			<string>PSSliderSpecifier</string>
			<key>Title</key>
			<string>圆角</string>
