		</dict>
		<dict>
			<key>Type</key>
			<string>PSToggleSwitchSpecifier</string>
			<key>Title</key>
			<string>启用语音免跳转</string>
			<key>Key</key>
			<string>wxkbdNoJumpEnabled</string>
			<key>DefaultValue</key>
			<true/>
			<key>TrueValue</key>
			<integer>1</integer>
			<key>FalseValue</key>
			<integer>0</integer>
		</dict>

		<dict>
			<key>Type</key>
			<string>PSGroupSpecifier</string>
			<key>Title</key>
			<string>键盘外观定制</string>
		</dict>
		<dict>
			<key>Type</key>
			<string>PSToggleSwitchSpecifier</string>
